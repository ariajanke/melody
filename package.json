{
  "dependencies": {
    "@stylistic/eslint-plugin": "^1.7.2",
    "@sweet-monads/either": "^3.3.1",
    "esbuild": "^0.20.2"
  },
  "scripts": {
    "build": "npx esbuild build.js --bundle --outfile=build/stuff.m.js",
    "build_for_tests": "cat build-tests.js | npx esbuild --bundle --outfile=build/tests.js",
    "lint": "npx eslint $(find src/ | grep '.ts$') $(find tests/ | grep -P '(?<!\\.d)\\.ts$')",
    "test": "npx jasmine build/tests.js",
    "watch": "npx tsc -w"
  },
  "include": [
    "**/*.ts"
  ],
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "eslint": "^8.57.0",
    "globals": "^15.3.0",
    "jasmine": "^5.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^7.9.0"
  },
  "compilerOptions": {}
}
