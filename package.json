{
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "npx esbuild $(find src/ | grep '.ts$')",
    "lint": "npx eslint $(find src/ | grep '.ts$') $(find tests/ | grep -P '(?<!\\.d)\\.ts$')",
    "test": "DEBUG_MODE=true npx jasmine $npm_config_testdir/tests.js",
    "watch": "npx tsc -w"
  },
  "include": [
    "**/*.ts"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@types/jasmine": "^6.0.0",
    "eslint": "^10.8.1",
    "fix-esm-import-path": "^1.10.3",
    "globals": "^17.9.0",
    "jasmine": "^6.3.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.66.0"
  },
  "compilerOptions": {},
  "name": "melody",
  "version": "0.0.1",
  "description": "Melody is a simple WASM compiled language. It's written mostly from scratch in TypeScript.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariajanke/melody.git"
  },
  "keywords": ["WASM", "Compiler"],
  "author": "Aria Janke",
  "license": "AGPLv3",
  "bugs": {
    "url": "https://github.com/ariajanke/melody/issues"
  },
  "homepage": "https://github.com/ariajanke/melody#readme"
}
