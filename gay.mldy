let Rational = table (class)
  make = fn (num is Integer, den is Integer)
    table
      $+ = fn (rhs is Rational) class.make(num + rhs.num, den + rhs.den)
      $- = fn (rhs is Rational) class.make(num - rhs.num, den - rhs.den)
      $* = fn (rhs is Rational) class.make(num*rhs.num, den*rhs.den)
      $/ = fn (rhs is Rational) class.make(num / rhs.num, den / rhs.den)
      numerator = num
      denominator = den
    ~
  ~
  $is = class.make
~

Rational is table
  make is Fn(Integer, Integer)
  $is is Table
~

