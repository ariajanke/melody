let Either = fn (LeftType like Passable type, RightType like Passable type)
  return table
    new = fn (l is LeftType, r is RightType) table
      map = fn (f is fn (RightType)) Either.new(l, f(r)),
      chain = fn (f is fn (RightType))
        # how do I know this is either a left or a right? I would need Optionals
      end,
      mapLeft = fn (f is fn (LeftType)) Either.new(f(l), r),
      chainLeft = fn (f is fn (LeftType)) f(l)
    end,
    left = fn (l is LeftType) table
      
    end
  end
end

Either(String, Integer).
  left('blew up').
  map(fn (x is Integer) x*2).
  chain(fn (x is Integer)
    if x > 10
      return Either.left('too big')
    else
      return Either.right(x - 1) # unresolved values are again okay
    end
  end)

# A class can just be an interface/variable combo

# interface Numeric 

let Rectangle = fn (t is Numeric type)
  let make_setter = fn (constructor is Fn(Return.of(class&.make))())
  end
  let class = table
    new = Referential.constructor(class.@make),
    make = fn (top: is t = 0, left: is t = 0, width: is t = 1, height: is t = 1)
      
      let inst = table
        top
        left
        width
        height
        area = fn width*height
        bottom = fn top + height
        right = fn left + width
        set =
          fn begin
            top: is t = inst.top,
            left: is t = inst.left,
            width: is t = inst.width,
            height: is t = inst.height,
            bottom: is t or null,
            right: is t or null
          end
          # make or new?
          let prefWidth = if right
            right - left
          end
          let prefHeight = if bottom
            bottom - top
          end
          # "$" refers to this function
          # "^" goes up
          @$
          class.
            foo(top:,
                left:,
                width: prefWidth or left,
                height: prefHeight or height)
        end
        # Fn()() == Fn (as in Same interface)
        tap = fn (f is Fn(r is Optionally $))
          f(inst)
          inst
        end
      end
    end
  end
end

