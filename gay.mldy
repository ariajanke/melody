let g = fn (interface_ is Table) fn (t is Multiplable.unify(interface_) type) fn (x is t) x*x

let g = fn (interface_ is Table)
  let pass = GenericFunction.identity
  Reduction(GenericFunction).
    of(pass).
    with(fn (f_cur is GenericFunction, f_prev is GenericFunction)
      if @f_cur.fits(interface_)
        @f_cur.compose @f_prev
      else
        @f_prev
      end
    end).on(
    # Some functions are not type resolvable until you try to call them
    # *this* is what partial resolution is
      (fn (t is Multiplable type) fn (x is t) x*x  ),
      (fn (t is Addable     type) fn (x is t) x + x)
    )
end
