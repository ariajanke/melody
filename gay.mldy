let Rational = table (class)
  make = fn (num is Integer, den is Integer)
    let public = table...
    $public.+ = fn(rhs is Rational) class.
      make(num + rhs.numerator, den + rhs.denominator)
    $public.- = fn(rhs is Rational) class.
      make(num - rhs.numerator, den - rhs.denominator)
    $public.* = fn(rhs is Rational) class.
      make(num*rhs.numerator, den*rhs.denominator)
    $public./ = fn(rhs is Rational) class.
      make(num / rhs.numerator, den / rhs.denominator)
    public.numerator = num
    public.denominator = den
    public
  ~
  $is = class.make
~

