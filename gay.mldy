# What is a type?
# A type describes a definite thing, with a well known byte size. Types are
# defined indirectly.
# builtin types:
# - Integer
# - String
# type reflections
# .resolvable # true if resolvable at time of invokation

# Integer
# well defined member functions:
# - '+' = fn (???, Integer) return Integer
# - '-' = fn (???, Integer) return Integer
# - '*' = fn (???, Integer) return Integer
# - ':=' = fn (???, Integer) return ???
# - '=' = fn (???, Integer) return Boolean
# - 'to_string' = fn(???) return String
#
# where ??? is some internally defined "reference"
#
# String
# - ':=' = fn (???, String) return String
# - 'to_string' = fn(???) return String

# does this mean puts is?
let puts is fn (str like String) return Void =
  begin
    __puts_Integer, # fn (Integer) return Void
    __puts_String   # fn (String ) return Void
  end

let Rectangle = fn (n is Number type)
  let new = fn (x is n, y is n, width is n = 1, height is n = 1)
    return let inst = table
      x := x,
      y := y,
      width := width,
      height := height,
      bottom = fn inst.y + inst.height,
      right = fn inst.x + inst.width,
      move = fn (x is n, y is n)
        inst.x += x
        inst.y += y
        return inst
      end
    end
  end

  return table
    new = new
  end
end

let RectangleI = Rectangle(Integer)

let add = fn (a like Number, b like Number)
  return a + b
end

