# how do I define lets with '='?
# how do I do null? especially on PoDs?

let Vector2Rat = fn
  let new = fn (x is Rational, y is Rational)
    return let inst = table
      x := x, # ":=" makes x unresolvable?
      y := y,
      magnitude = fn Rational.sqrt(inst.x * inst.x + inst.y * inst.y),
      # though we know that either maybe returned...
      normalize = fn () # so... partial type resolution?
        let mag = inst.magnitude()
        # how would the intepreter figure this out?
        let ResFunc     = interface fn (res is new.return_type) return Void
        # here's a tough question, how do we know that
        # do_nothing and give_result are the same type?
        let give_result =
          fn (func like ResFunc) func(new(inst.x / mag, inst.y / mag))
        let do_nothing = fn (like ResFunc) end
        # remember: mag's value is in fact *unresolvable*
        # we would have to resolve on every possible thing that's returned
        if mag = 0
          return do_nothing # we're returning a sort of generic function
        end
        return give_result
      end
    end
  end
  return table
    new = new
  end
end()


