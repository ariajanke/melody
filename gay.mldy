let GenericConditional = fn (t is Passable)
  return table
    make_true = fn(a is t)
      return let inst = table
        else_if = fn(c is Boolean, f2 is Fn())
          return inst
        end
        else = fn(f2 is Fn())
          return inst
        end
        value = t
      end
    end
  end
end
let Boolean = table
  # ...
  true = table
    then = fn(f2 is Fn())
      return GenericConditional(f2.return_type).make_true(f2())
    end
  end
  false = table
    then = fn(f2 is Fn())
      return GenericConditional(f2.return_type).make_false()
    end
  end
  $is is Boolean.make_type
  make_type is table
    then is
      Fn(f2 is Fn())(GenericConditional( f2.return_type )) =
      fn(f is Fn())
      end
  end
end

let Boolean = fn ()
  let GenericFalse = fn (return_value is Passable)
    table
      make = fn (return_value is return_type) table
        else_if = fn (b is Boolean, f is Fn()) b.then f
        else = fn (f is Fn()) f
        $call = return_value
      ;
    ;
  ;
  let GenericTrue = fn (return_value is Passable)
    table
      make = fn () let inst = table
        else_if = fn (b is Boolean, f is Fn()) inst
        else = fn (f is Fn()) inst
        # So... settlement and call are served by the same role?
        $call = return_value
      ;
    ;
  ;
  let true is Boolean = table
    then = fn (f is Fn()) GenericTrue f
  ;
  let false is Boolean = table
    then = fn (f is Fn()) GenericFalse(Fn.of(f).return_type)
  ;
  table
    true
    false
  ;
;()

