
export interface WasmFunctionByteCodeEmitter {
  prependCode(extraCode: number[]): this;
  prependCodeTo(wfb: this): this;
  pushI32Const(constant: number): this;
  pushI32Add(): this;
  pushI32Subtract(): this;
  pushI32Multiply(): this;
  pushI32Load(): this;
  pushI32Store(): this;
  pushFunctionCall(funcIdx: number): this;
  pushLocal(): this;
  localCount(): number;
  stackCount(): number;
  pushDrop(): this;
  setLocal(idx: number): this;
  getLocal(idx: number): this;
  setGlobal(idx: number): this;
  getGlobal(idx: number): this;
  callIndirect(typeIdx: number): this;
  pushTeeLocal(idx: number): this;
  finish(): Readonly<number[]>;
};

